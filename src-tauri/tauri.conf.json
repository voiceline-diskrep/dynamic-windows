{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dynamic-windows",
  "version": "1.4.10",
  "identifier": "com.voiceline-diskrep.dynamicwindows",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dynamic Windows",
        "url": "island.html",
        "width": 1000,
        "height": 450,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
